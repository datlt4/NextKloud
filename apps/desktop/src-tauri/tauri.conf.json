{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NextKloud",
  "version": "0.1.27",
  "identifier": "com.nextkloud.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NextKloud",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "windows": {
      "nsis": {},
      "wix": {}
    },
    "linux": {
      "deb": {},
      "appimage": {}
    },
    "macOS": {},
    "android": {},
    "iOS": {},
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI2RUNCNjBGMjY4RjdGMzAKUldRd2Y0OG1EN2JzSnJ1M2JEazMyaStKM0EyK01RS0tRaUE0Vks4R2Z1dktHOENaek1pUXJHWFQK",
      "endpoints": [
        "https://github.com/datlt4/NextKloud/releases/latest/download/latest.json"
      ]
    }
  }
}
